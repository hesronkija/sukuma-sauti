 },
 {
  "id": "s-shule_na_kazi-14",
  "type": "sentence",
  "topic": "shule_na_kazi",
  "sw": "Mshahara umechelewa mwezi huu."
 },
 {
  "id": "s-shule_na_kazi-15",
