  "sw": "Funga dirisha, kuna baridi."
 },
 {
  "id": "s-nyumbani-03",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Nenda ukachote maji kisimani."
 },
 {
  "id": "s-nyumbani-04",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Fagia uwanja."
 },
 {
  "id": "s-nyumbani-05",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Nguo zimekauka, zianue."
 },
 {
  "id": "s-nyumbani-06",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Leta kiti hapa."
 },
 {
  "id": "s-nyumbani-07",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Kaa chini upumzike."
 },
 {
  "id": "s-nyumbani-08",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Unatafuta nini?"
 },
 {
  "id": "s-nyumbani-09",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Sijui alikokwenda."
 },
 {
  "id": "s-nyumbani-10",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Nisaidie kubeba mzigo huu."
 },
 {
  "id": "s-nyumbani-11",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Usifanye kelele, mtoto amelala."
 },
 {
  "id": "s-nyumbani-12",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Njoo hapa haraka."
 },
 {
  "id": "s-nyumbani-13",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Ngoja kidogo, ninakuja."
 },
 {
  "id": "s-nyumbani-14",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Unasema nini? Sijasikia."
 },
 {
  "id": "s-nyumbani-15",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Sema polepole tafadhali."
 },
 {
  "id": "s-nyumbani-16",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Ninakupenda sana."
 },
 {
  "id": "s-nyumbani-17",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Nina furaha leo."
 },
 {
  "id": "s-nyumbani-18",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Usiogope."
 },
 {
  "id": "s-nyumbani-19",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Kuna harusi kijijini kesho."
 },
 {
  "id": "s-nyumbani-20",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Tutacheza ngoma usiku."
 },
 {
  "id": "s-nyumbani-21",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Kuna msiba kwa jirani yetu."
 },
 {
  "id": "s-nyumbani-22",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Tutakwenda kanisani Jumapili."
 },
 {
  "id": "s-nyumbani-23",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Mbwa anabweka nje."
 },
 {
  "id": "s-nyumbani-24",
  "type": "sentence",
  "topic": "nyumbani",
  "sw": "Nimepoteza ufunguo."
 },
 {
