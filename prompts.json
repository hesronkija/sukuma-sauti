  "sw": "Amefaulu mtihani wake."
 },
 {
  "id": "s-simu_na_pesa-01",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Nipigie simu baadaye."
 },
 {
  "id": "s-simu_na_pesa-02",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Simu yangu haina chaji."
 },
 {
  "id": "s-simu_na_pesa-03",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Sina salio la kutosha."
 },
 {
  "id": "s-simu_na_pesa-04",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Nitumie pesa kwa simu."
 },
 {
  "id": "s-simu_na_pesa-05",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Nimepokea ujumbe wako."
 },
 {
  "id": "s-simu_na_pesa-06",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Mtandao haupatikani hapa."
 },
 {
  "id": "s-simu_na_pesa-07",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Namba yako ya simu ni ipi?"
 },
 {
  "id": "s-simu_na_pesa-08",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Nitakupigia jioni."
 },
 {
  "id": "s-simu_na_pesa-09",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Umeme umekatika."
 },
 {
  "id": "s-simu_na_pesa-10",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Nikopeshe shilingi elfu tano."
 },
 {
  "id": "s-simu_na_pesa-11",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Nitakulipa mwisho wa mwezi."
 },
 {
  "id": "s-simu_na_pesa-12",
  "type": "sentence",
  "topic": "simu_na_pesa",
  "sw": "Washa redio tusikilize habari."
 },
 {
  "id": "s-nyumbani-01",
  "type": "sentence",
